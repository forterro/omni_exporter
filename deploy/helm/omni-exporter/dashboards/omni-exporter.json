          },
          "expr": "count by (omni_instance) (omni_exporter_machine_connected{omni_instance=~\"$omni_instance\"}) or (clamp_max(max by (omni_instance) (omni_exporter_up{omni_instance=~\"$omni_instance\"}) == 1, 0))",
          "legendFormat": "{{omni_instance}} total"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (omni_instance) (omni_exporter_machine_connected{omni_instance=~\"$omni_instance\"}) or (clamp_max(max by (omni_instance) (omni_exporter_up{omni_instance=~\"$omni_instance\"}) == 1, 0))",
          "legendFormat": "{{omni_instance}} connected"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Machine Power States",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
